{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manabi-rouge.app/schemas/bank-soal-1.0.0.json",
  "title": "Manabi-Rouge Question Bank",
  "description": "Skema kanonik bank butir soal Manabi-Rouge untuk JLPT N5-N1 dan JFT-Basic. Versi 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bank_version", "generated_at", "taxonomy", "stimuli", "items"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bank_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "locale_default": { "enum": ["id", "en"] },
    "taxonomy": { "$ref": "#/$defs/Taxonomy" },
    "scoring_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/ScoringProfile" }
    },
    "stimuli": {
      "type": "array",
      "items": { "$ref": "#/$defs/Stimulus" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Item" }
    },
    "form_blueprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/FormBlueprint" }
    }
  },
  "$defs": {
    "ExamFamily": { "enum": ["jlpt", "jft"] },
    "Level": { "enum": ["N5", "N4", "N3", "N2", "N1"] },
    "StimulusLevel": { "enum": ["N5", "N4", "N3", "N2", "N1", "JFT"] },
    "SectionCode": {
      "enum": [
        "moji-goi",
        "bunpou",
        "dokkai",
        "choukai",
        "script-vocab",
        "conversation-expression",
        "listening",
        "reading"
      ]
    },
    "ScoringSectionCode": {
      "enum": ["language-reading", "listening", "jft-sv", "jft-ce", "jft-lc", "jft-rc"]
    },
    "ItemStatus": {
      "enum": ["draft", "content_review", "native_review", "pilot", "published", "superseded", "retired"]
    },
    "Instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      }
    },
    "FuriganaSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "reading": { "type": "string" }
      }
    },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text", "is_correct", "rationale"],
      "properties": {
        "key": { "enum": ["a", "b", "c", "d"] },
        "text": { "type": "string", "minLength": 1 },
        "is_correct": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "Explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short", "rule", "contrast", "transfer"],
      "properties": {
        "short": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "contrast": { "type": "string", "minLength": 1 },
        "transfer": { "type": "string", "minLength": 1 },
        "refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "KnowledgeTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["vocab", "kanji", "grammar", "function", "scenario", "particle"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "DifficultyFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexical_rarity", "kanji_load", "syntax_depth", "inference", "distractor_similarity", "processing", "register"],
      "properties": {
        "lexical_rarity": { "type": "number", "minimum": 0, "maximum": 3 },
        "kanji_load": { "type": "number", "minimum": 0, "maximum": 3 },
        "syntax_depth": { "type": "number", "minimum": 0, "maximum": 3 },
        "inference": { "type": "number", "minimum": 0, "maximum": 3 },
        "distractor_similarity": { "type": "number", "minimum": 0, "maximum": 3 },
        "processing": { "type": "number", "minimum": 0, "maximum": 3 },
        "register": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    },
    "Calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "b": { "type": ["number", "null"] },
        "a": { "type": ["number", "null"] },
        "infit": { "type": ["number", "null"] },
        "outfit": { "type": ["number", "null"] },
        "updated_at": { "type": "string" }
      }
    },
    "Difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "prior_logit", "features", "calibration"],
      "properties": {
        "band": { "type": "integer", "minimum": 1, "maximum": 5 },
        "prior_logit": { "type": "number" },
        "features": { "$ref": "#/$defs/DifficultyFeatures" },
        "calibration": { "$ref": "#/$defs/Calibration" }
      }
    },
    "Media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": ["string", "null"] },
            "transcript": { "type": ["string", "null"] },
            "play_limit": { "enum": [1, 2] },
            "duration_sec": { "type": "number", "minimum": 1 },
            "speed": { "enum": ["slow", "natural"] }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "alt": { "type": "string" }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    },
    "Accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["furigana_policy", "extended_time_ok"],
      "properties": {
        "furigana_policy": { "enum": ["off", "on-demand", "always"] },
        "alt_text": { "type": ["string", "null"] },
        "audio_transcript": { "type": ["string", "null"] },
        "extended_time_ok": { "type": "boolean" }
      }
    },
    "Exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_eligible", "max_exposure_per_user_days", "enemy_ids"],
      "properties": {
        "form_eligible": { "type": "boolean" },
        "max_exposure_per_user_days": { "type": "integer", "minimum": 0 },
        "enemy_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer", "native_review", "source", "license", "ai_assisted"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "native_review": { "type": "boolean" },
        "source": { "enum": ["original", "licensed", "open-data"] },
        "license": { "type": "string" },
        "ai_assisted": { "type": "boolean" },
        "created_at": { "type": "string" }
      }
    },
    "Stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "level", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^ST-[A-Z0-9-]+$" },
        "kind": {
          "enum": ["passage", "dialogue", "notice", "email", "table", "image", "announcement", "utterance"]
        },
        "level": { "$ref": "#/$defs/StimulusLevel" },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/FuriganaSegment" } },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "en": { "type": "string" }
          }
        },
        "script": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "jp"],
            "properties": {
              "speaker": { "type": "string" },
              "jp": { "type": "string", "minLength": 1 },
              "kana": { "type": "string" },
              "id": { "type": "string" }
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": ["string", "null"] },
            "duration_sec": { "type": "number", "minimum": 1 },
            "play_limit": { "enum": [1, 2] },
            "speed": { "enum": ["slow", "natural"] },
            "voice": { "type": ["string", "null"] }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "alt": { "type": "string" }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "license": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "status",
        "exam_family",
        "level",
        "test_section",
        "scoring_section",
        "item_type",
        "instruction",
        "stem",
        "options",
        "answer_key",
        "explanation",
        "knowledge_tags",
        "skill_tags",
        "difficulty",
        "media",
        "accessibility",
        "exposure",
        "provenance",
        "time_estimate_sec",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^MR-(N[1-5]|JFT)-[A-Z]{1,3}-[A-Z]{2,3}-[0-9]{4}$" },
        "schema_version": { "const": "1.0.0" },
        "status": { "$ref": "#/$defs/ItemStatus" },
        "exam_family": { "$ref": "#/$defs/ExamFamily" },
        "level": { "type": ["string", "null"], "enum": ["N5", "N4", "N3", "N2", "N1", null] },
        "cefr": { "type": ["string", "null"], "enum": ["A1", "A2", "B1", "B2", "C1", null] },
        "test_section": { "$ref": "#/$defs/SectionCode" },
        "scoring_section": { "$ref": "#/$defs/ScoringSectionCode" },
        "item_type": { "type": "string", "pattern": "^[A-Z]{1,3}\\.[A-Z]{2,4}$" },
        "instruction": { "$ref": "#/$defs/Instruction" },
        "stem": { "type": "string", "minLength": 1 },
        "stem_furigana": { "type": "array", "items": { "$ref": "#/$defs/FuriganaSegment" } },
        "blank_index": { "type": "integer", "minimum": 1 },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/Option" }
        },
        "answer_key": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } },
        "explanation": { "$ref": "#/$defs/Explanation" },
        "stimulus_refs": { "type": "array", "items": { "type": "string" } },
        "knowledge_tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/KnowledgeTag" } },
        "skill_tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scenario": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "$ref": "#/$defs/Difficulty" },
        "media": { "$ref": "#/$defs/Media" },
        "accessibility": { "$ref": "#/$defs/Accessibility" },
        "exposure": { "$ref": "#/$defs/Exposure" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "time_estimate_sec": { "type": "integer", "minimum": 5, "maximum": 600 },
        "version": { "type": "integer", "minimum": 1 },
        "also_valid_for": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exam_family", "item_type"],
            "properties": {
              "exam_family": { "$ref": "#/$defs/ExamFamily" },
              "item_type": { "type": "string", "pattern": "^[A-Z]{1,3}\\.[A-Z]{2,4}$" },
              "level": { "type": ["string", "null"], "enum": ["N5", "N4", "N3", "N2", "N1", null] }
            }
          }
        },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "ItemType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exam_family", "section", "label_jp", "label_id", "option_count", "levels", "active"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{1,3}\\.[A-Z]{2,4}$" },
        "exam_family": { "$ref": "#/$defs/ExamFamily" },
        "section": { "$ref": "#/$defs/SectionCode" },
        "label_jp": { "type": "string" },
        "label_id": { "type": "string" },
        "option_count": { "enum": [3, 4] },
        "levels": { "type": "array", "items": { "$ref": "#/$defs/Level" } },
        "jft_equiv": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "Taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_types"],
      "properties": {
        "version": { "type": "string" },
        "item_types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ItemType" } },
        "notes": { "type": "string" }
      }
    },
    "ScoringSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "max"],
      "properties": {
        "key": { "type": "string" },
        "max": { "type": "number", "minimum": 1 },
        "min_pass": { "type": ["number", "null"] }
      }
    },
    "Band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "min", "max"],
      "properties": {
        "label": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "ScoringProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exam_family", "effective_from", "config"],
      "properties": {
        "code": { "type": "string" },
        "exam_family": { "$ref": "#/$defs/ExamFamily" },
        "effective_from": { "type": "string" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_total", "sections"],
          "properties": {
            "max_total": { "type": "number" },
            "overall_pass": { "type": ["number", "null"] },
            "sections": { "type": "array", "items": { "$ref": "#/$defs/ScoringSection" } },
            "bands": { "type": "array", "items": { "$ref": "#/$defs/Band" } },
            "note": { "type": "string" }
          }
        }
      }
    },
    "FormSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "items", "distribution"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "minutes": { "type": ["integer", "null"] },
        "items": { "type": "integer", "minimum": 1 },
        "distribution": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "note": { "type": "string" }
      }
    },
    "FormBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exam_family", "level", "version", "minutes", "total_items", "sections"],
      "properties": {
        "id": { "type": "string" },
        "exam_family": { "$ref": "#/$defs/ExamFamily" },
        "level": { "type": ["string", "null"], "enum": ["N5", "N4", "N3", "N2", "N1", null] },
        "version": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 },
        "total_items": { "type": "integer", "minimum": 1 },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FormSection" } },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "difficulty_mix": { "type": "object", "additionalProperties": { "type": "number" } },
            "answer_position_balance": { "type": "boolean" },
            "max_same_position_streak": { "type": "integer", "minimum": 1 },
            "max_items_per_stimulus": { "type": "integer", "minimum": 1 },
            "exposure_window_days": { "type": "integer", "minimum": 0 },
            "enemy_items": { "type": "boolean" },
            "anchor_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": { "type": "string" },
            "sections": { "type": "array", "items": { "$ref": "#/$defs/ScoringSection" } },
            "overall_pass": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
